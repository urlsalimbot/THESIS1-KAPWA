{
  "name": "kapwa-server",
  "version": "1.0.0",
  "type": "module",
  "description": "KAPWA - MSWDO Norzagaray Social Welfare System",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "node --import=tsimp/import --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/database/migrate.js",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/database/data-source.ts",
    "migration:run:prod": "node dist/database/run-migrations.js",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/database/data-source.ts src/database/migrations/Generation",
    "typeorm": "typeorm-ts-node-esm",
    "seed": "node --import=tsimp/import src/database/seed-accounts.ts",
    "seed:prod-demo": "node --import=tsimp/import src/database/seed-prod-demo.ts",
    "seed:programs": "node --import=tsimp/import src/database/seed-programs.ts",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=unit",
    "seed:demo": "node --import=tsimp/import src/database/seed-demo.ts",
    "seed:extras": "node --import=tsimp/import src/database/seed-demo-extras.ts",
    "seed:demo:all": "npm run seed && npm run seed:programs && npm run seed:demo && npm run seed:team-demo && npm run seed:extras",
    "seed:team-demo": "node --import=tsimp/import src/database/seed-team-demo.ts",
    "check:barangay-drift": "node --import=tsimp/import scripts/check-barangay-drift.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.26",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cockatiel": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "csv-stringify": "^6.8.0",
    "exceljs": "^4.4.0",
    "helmet": "^7.1.0",
    "minio": "^8.0.7",
    "nodemailer": "^10.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.17.5",
    "socket.io": "^4.8.3",
    "twilio": "^6.0.2",
    "typeorm": "^0.4.0-alpha.1",
    "uuid": "^14.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsimp": "^2.0.12",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "tar": "^7.5.21",
    "follow-redirects": "^1.16.2",
    "multer": "^2.5.0",
    "body-parser": "^2.4.0"
  }
}
