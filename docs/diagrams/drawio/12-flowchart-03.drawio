  <diagram id="dfd-f3-—-household-intake-and-case-opening" name="F3 — Household intake and case opening">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A family arrives for help" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="381" y="0" width="158" height="48" as="geometry"/></mxCell><mxCell id="take" value="Capture household particulars and the request" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="206" y="92" width="508" height="48" as="geometry"/></mxCell><mxCell id="look" value="Households already known to the office" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="184" width="250" height="48" as="geometry"/></mxCell><mxCell id="found" value="A matching household is on file?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="282" y="276" width="356" height="48" as="geometry"/></mxCell><mxCell id="see" value="Show the match beside what was given" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="215" y="381" width="253" height="48" as="geometry"/></mxCell><mxCell id="same" value="The worker confirms it is the same household?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="485" width="499" height="48" as="geometry"/></mxCell><mxCell id="join" value="Attach the request to that household" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeCol