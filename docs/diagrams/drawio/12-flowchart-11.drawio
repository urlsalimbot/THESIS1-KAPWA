  <diagram id="dfd-f11-—-disbursement-and-instruments" name="F11 — Disbursement and instruments">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="An approval has been recorded" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="76" y="0" width="201" height="48" as="geometry"/></mxCell><mxCell id="check" value="The approval is in order?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="37" y="92" width="280" height="48" as="geometry"/></mxCell><mxCell id="wait" value="Hold the papers until the approval is settled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="197" width="273" height="48" as="geometry"/></mxCell><mxCell id="coe" value="Issue the certificate of eligibility" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="307" y="197" width="205" height="48" as="geometry"/></mxCell><mxCell id="pcv" value="Prepare the petty cash voucher" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="308" y="289" width="203" height="48" as="geometry"/></mxCell><mxCell id="fund" value="Release the funds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="346" y="381" width="127" height="48" as="geometry"/></mxCell><mxCell id="slip" value="Take the family&#39;s receipt and signature" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="194" y="473" width