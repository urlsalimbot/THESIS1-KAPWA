  <diagram id="dfd-f16-—-field-capture-and-later-submission" name="F16 — Field capture and later submission">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A worker is in the field" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="175" y="0" width="150" height="48" as="geometry"/></mxCell><mxCell id="take" value="Capture notes and particulars at the doorstep" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="92" width="500" height="48" as="geometry"/></mxCell><mxCell id="save" value="Keep the notes safe on the device" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="184" width="220" height="48" as="geometry"/></mxCell><mxCell id="link" value="The office can be reached?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="98" y="276" width="303" height="48" as="geometry"/></mxCell><mxCell id="queue" value="Leave the notes waiting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="381" width="159" height="48" as="geometry"/></mxCell><mxCell id="send" value="Submit the waiting notes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="323" y="381" width="165" height="48" as="geometry"/></mxCell><mxCell id="fair" value="The office accepts every change?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="54" y="473" width="370" height="48"