  <diagram id="dfd-f10-—-access-card-issuance-and-use" name="F10 — Access card issuance and use">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A household comes under the office&#39;s care" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="57" y="0" width="267" height="48" as="geometry"/></mxCell><mxCell id="fit" value="The household qualifies for a card?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="92" width="382" height="48" as="geometry"/></mxCell><mxCell id="no" value="Explain the reason and record the visit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="41" y="266" width="244" height="48" as="geometry"/></mxCell><mxCell id="make" value="Prepare the card and its code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="213" y="197" width="192" height="48" as="geometry"/></mxCell><mxCell id="hand" value="Give the card to the household" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="266" y="335" width="199" height="48" as="geometry"/></mxCell><mxCell id="serve" value="Note every assistance against the card" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="295" y="427" width="249" height="48" as="geometry"/></mxCell><mxCell id="gone" value="The card is lost, destroyed or expired?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="212" y="519" width="416" height="48" as="geome