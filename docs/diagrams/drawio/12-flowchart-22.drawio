  <diagram id="dfd-f22-—-recovering-a-forgotten-password" name="F22 — Recovering a forgotten password">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A person cannot remember their secret phrase" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="423" y="0" width="289" height="48" as="geometry"/></mxCell><mxCell id="tell" value="Give the account name they sign in with" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="342" y="92" width="450" height="48" as="geometry"/></mxCell><mxCell id="send" value="Send a message with a way to choose a new one" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="412" y="184" width="311" height="48" as="geometry"/></mxCell><mxCell id="fresh" value="Is the message used while it is current?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="219" y="276" width="431" height="48" as="geometry"/></mxCell><mxCell id="again" value="Ask for a fresh message when the old one has lapsed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="534" y="381" width="334" height="48" as="geometry"/></mxCell><mxCell id="pick" value="Choose a new secret phrase" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="168" y="381" width="332" height="48" as="geometry"/></mxCell><mxCell id="rule" value="Does it meet what the office requires?" style="rhombus;whiteSpace=w