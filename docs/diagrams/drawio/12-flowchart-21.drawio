  <diagram id="dfd-f21-—-staff-account-administration" name="F21 — Staff account administration">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A new member of staff joins the office" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="197" y="0" width="240" height="48" as="geometry"/></mxCell><mxCell id="take" value="Take their name, contact details and the role they will hold" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="92" width="634" height="48" as="geometry"/></mxCell><mxCell id="reach" value="Do they serve one barangay or the whole municipality?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="27" y="184" width="579" height="48" as="geometry"/></mxCell><mxCell id="post" value="Note the barangay they answer for" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="51" y="289" width="222" height="48" as="geometry"/></mxCell><mxCell id="wide" value="Note that they may work anywhere in the municipality" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="307" y="289" width="334" height="48" as="geometry"/></mxCell><mxCell id="make" value="Prepare the account and its first secret phrase" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="172" y="381" width="290" height="48" as="geometry"/></mxCell><mxCell id="hand" value="Hand over the sign-in details" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;