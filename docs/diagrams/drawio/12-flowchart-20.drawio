  <diagram id="dfd-f20-—-programme-catalogue-upkeep" name="F20 — Programme catalogue upkeep">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="The office reviews what it offers" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="454" y="0" width="206" height="48" as="geometry"/></mxCell><mxCell id="what" value="A new programme, a change, or one to set aside?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="294" y="92" width="528" height="48" as="geometry"/></mxCell><mxCell id="add" value="Write its name, purpose and basis" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34" y="197" width="387" height="48" as="geometry"/></mxCell><mxCell id="amend" value="Correct the programme&#39;s details" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="454" y="197" width="207" height="48" as="geometry"/></mxCell><mxCell id="scope" value="Choose the services it renders and the documents it requires" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="335" width="662" height="48" as="geometry"/></mxCell><mxCell id="keep" value="Keep it in the catalogue the staff work from" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="386" y="427" width="271" height="48" as="geometry"/></mxCell><mxCell id="shown" value="It appears wherever a programme may be chosen" style="rounded=0