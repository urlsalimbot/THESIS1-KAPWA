  <diagram id="dfd-f7-—-assistance-decision-and-delivery" name="F7 — Assistance decision and delivery">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A need has been studied" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="0" width="164" height="48" as="geometry"/></mxCell><mxCell id="weigh" value="Weigh the need against what the office can give" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="102" y="92" width="299" height="48" as="geometry"/></mxCell><mxCell id="need" value="Assistance is required?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="118" y="184" width="268" height="48" as="geometry"/></mxCell><mxCell id="none" value="State that no assistance is needed and hold the case for review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="358" width="391" height="48" as="geometry"/></mxCell><mxCell id="kind" value="Choose the kind of assistance" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="289" y="289" width="350" height="48" as="geometry"/></mxCell><mxCell id="docs" value="The documents this assistance requires are complete?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="427" width="577" height="48" as="geometry"/></mxCell><mxCell id="chase" value="Ask the family for what is missing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex