  <diagram id="dfd-f18-—-public-inquiry-and-reply" name="F18 — Public inquiry and reply">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A visitor writes to the office" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="0" width="179" height="48" as="geometry"/></mxCell><mxCell id="send" value="Send the inquiry from the public page" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="92" width="419" height="48" as="geometry"/></mxCell><mxCell id="list" value="It joins the inquiry list, with the waiting count" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="69" y="184" width="280" height="48" as="geometry"/></mxCell><mxCell id="need" value="Does it call for an answer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="58" y="276" width="302" height="48" as="geometry"/></mxCell><mxCell id="aside" value="Set it aside as read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="450" width="134" height="48" as="geometry"/></mxCell><mxCell id="write" value="Write the answer with the visitor&#39;s words to hand" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="232" y="381" width="537" height="48" as="geometry"/></mxCell><mxCell id="reply" value="Send the answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;font