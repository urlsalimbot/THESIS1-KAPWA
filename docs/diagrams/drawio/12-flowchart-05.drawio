  <diagram id="dfd-f5-—-case-review-and-activation" name="F5 — Case review and activation">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A finished assessment is offered for review" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="263" y="0" width="271" height="48" as="geometry"/></mxCell><mxCell id="hold" value="Place the case in the review list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="295" y="92" width="207" height="48" as="geometry"/></mxCell><mxCell id="read" value="The reviewer weighs the study and the documents" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="242" y="184" width="314" height="48" as="geometry"/></mxCell><mxCell id="decide" value="Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="255" y="276" width="142" height="48" as="geometry"/></mxCell><mxCell id="back" value="Return the case with remarks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="229" y="381" width="193" height="48" as="geometry"/></mxCell><mxCell id="redo" value="The worker answers the remarks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="473" width="212" height="48" as="geometry"/></mxCell><mxCell id="active" value="Mark the case active" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="381" width="143" height="48" as="geometry"/></mxCell><mxCell id="tell" v