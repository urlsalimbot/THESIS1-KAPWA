<mxfile host="kapwa-diagrams" type="device" version="24.0.0">
  <diagram id="dfd-f9-—-incident-report-handling" name="F9 — Incident report handling">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A report of harm or neglect arrives" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="126" y="0" width="218" height="48" as="geometry"/></mxCell><mxCell id="file" value="Take the account of what happened" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="33" y="92" width="403" height="48" as="geometry"/></mxCell><mxCell id="soft" value="Names or identities are at risk?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="62" y="184" width="346" height="48" as="geometry"/></mxCell><mxCell id="guard" value="Keep the account away from ordinary view" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="289" width="269" height="48" as="geometry"/></mxCell><mxCell id="weigh" value="Weigh the danger to the person" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="134" y="381" width="202" height="48" as="geometry"/></mxCell><mxCell id="police" value="The matter must go to the authorities?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="28" y="473" width="414" height="48" as="geometry"/></mxCell><mxCell id="pass" value="Hand it to the proper authority" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="23" y="577" width="194" height="48" as="geometry"/></mxCell><mxCell id="own" value="Keep the matter with the office" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="251" y="577" width="199" height="48" as="geometry"/></mxCell><mxCell id="decide" value="Write the disposition with reasons" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="126" y="669" width="217" height="48" as="geometry"/></mxCell><mxCell id="done" value="The report is closed and kept for audit" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="114" y="761" width="241" height="48" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;fontSize=9;fontColor=#111111;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="file"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;fontSize=9;fontColor=#111111;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="file" target="soft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;fontSize=9;fontColor=#111111;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="soft" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;fontSize=9;fontColor=#111111;exitX=1;exitY=0.5;exitDx=0;exit