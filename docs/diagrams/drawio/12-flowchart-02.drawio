  <diagram id="dfd-f2-—-sign-in-and-role-landing" name="F2 — Sign-in and role landing">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A person wants to work in the system" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="481" y="0" width="241" height="48" as="geometry"/></mxCell><mxCell id="creds" value="Present account name and secret phrase" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="372" y="92" width="459" height="48" as="geometry"/></mxCell><mxCell id="verified" value="The address has been confirmed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="236" y="184" width="371" height="48" as="geometry"/></mxCell><mxCell id="confirm" value="Ask them to open the confirmation message first" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="358" width="304" height="48" as="geometry"/></mxCell><mxCell id="enabled" value="The account is still in use?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="271" y="289" width="302" height="48" as="geometry"/></mxCell><mxCell id="hold" value="Send them to the administrator who disabled it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="177" y="497" width="291" height="48" as="geometry"/></mxCell><mxCell id="match" value="Credentials correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="427" width="235" height="48" as="geometry"/></mxCell><mxCell id="refuse" value="Show a clear refusal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="737" y="566" width="140" height="48" as="geometry"/></mxCell><mxCell id="extra" value="A second check is required for this role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="271" y="566" width="433" height="48" as="geometry"/></mxCell><mxCell id="code" value="Enter the verification code sent to the person" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="415" y="671" width="498" height="48" as="geometry"/></mxCell><mxCell id="good" value="Code current and correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="775" width="293" height="48" as="geometry"/></mxCell><mxCell id="open" value="Open the workspace that belongs to the role" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="880" width="278" height="48" as="geometry"/></mxCell><mxCell id="done" value="The person is at work" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="146" y="972" width="147" height="48" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#111111;fontSize=9;fontColor=#111111;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="creds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="