  <diagram id="dfd-f24-—-barangay-coordinator-files-a-referral" name="F24 — Barangay coordinator files a referral">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A barangay officer knows a family in need" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="368" y="0" width="263" height="48" as="geometry"/></mxCell><mxCell id="take" value="Take the family&#39;s particulars and what they need" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="233" y="92" width="533" height="48" as="geometry"/></mxCell><mxCell id="file" value="File the referral to the office" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="184" width="180" height="48" as="geometry"/></mxCell><mxCell id="wait" value="It waits in the office&#39;s referral list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="276" width="210" height="48" as="geometry"/></mxCell><mxCell id="weigh" value="The office weighs it against the help it has" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="367" y="368" width="266" height="48" as="geometry"/></mxCell><mxCell id="take2" value="Does the office take the family in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="312" y="460" width="375" height="48" as="geometry"/></mxCell><mxCell id="why" value="Write why not, and what the family may try instead" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=