  <diagram id="dfd-f23-—-personal-details-and-preferences" name="F23 — Personal details and preferences">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="A person wants to change something of their own" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="749" y="0" width="308" height="48" as="geometry"/></mxCell><mxCell id="what" value="What do they want to change?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="734" y="92" width="339" height="48" as="geometry"/></mxCell><mxCell id="phrase" value="Give the secret phrase in use and the new one" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="197" width="515" height="48" as="geometry"/></mxCell><mxCell id="reach" value="Give the new address or telephone number" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="197" width="477" height="48" as="geometry"/></mxCell><mxCell id="check" value="Is the phrase in use correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="453" y="335" width="319" height="48" as="geometry"/></mxCell><mxCell id="no" value="Refuse the change and say why" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="518" y="509" width="209" height="48" as="geometry"/></mxCell><mxCell id="move" value="Does the new address have to be confirmed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2c