-- Indexes that PostgreSQL supports and plain Oracle DDL does not.
-- Left as comments so nothing is lost and the import still parses.

-- CREATE INDEX idx_person_name_trgm ON persons USING gin (surname gin_trgm_ops, first_name gin_trgm_ops)
--   ^ GIN/GiST index: no Oracle equivalent in plain DDL; use Oracle Text / a function-based index instead.

-- CREATE INDEX idx_person_search ON persons USING gin (search_vector)
--   ^ GIN/GiST index: no Oracle equivalent in plain DDL; use Oracle Text / a function-based index instead.

-- CREATE UNIQUE INDEX uq_reminder_system_type ON reminder_settings USING btree (event_type) WHERE ((scope)::text = 'system'::text)
--   ^ PostgreSQL partial index. Oracle has no partial indexes; the predicate
--     ((scope)::text = 'system'::text)
--     would have to become a function-based index.

-- CREATE UNIQUE INDEX uq_reminder_worker_type ON reminder_settings USING btree (user_id, event_type) WHERE ((scope)::text = 'worker'::text)
--   ^ PostgreSQL partial index. Oracle has no partial indexes; the predicate
--     ((scope)::text = 'worker'::text)
--     would have to become a function-based index.

-- CREATE UNIQUE INDEX uq_team_invites_pending ON team_invites USING btree (from_user_id, to_user_id, invite_date) WHERE ((status)::text = 'pending'::text)
--   ^ PostgreSQL partial index. Oracle has no partial indexes; the predicate
--     ((status)::text = 'pending'::text)
--     would have to become a function-based index.
