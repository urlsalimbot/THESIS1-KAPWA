__pycache__/
*.pyc

# Local test artifacts
*.png
!docs/**/*.png

# local production-DB debug env (never commit)
.env.prodlocal
.env.localdb

# GIS live-preview scratch (watcher emits into .preview-build/ and pdf/preview/)
.preview-build/
kapwa-server/.preview-build/
pdf/preview/
