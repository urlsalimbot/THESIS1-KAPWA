# ============================================================
# Kapwa Environment Template
# ============================================================
# Copy to .env.production (or .env for local dev) and fill in
# every value. NEVER commit real secrets to version control.
# ============================================================

# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_USER=kapwa
DB_PASSWORD=change-me
DB_NAME=kapwa

# --- Authentication ---
JWT_SECRET=generate-with: openssl rand -hex 32
SYNC_SECRET=generate-with: openssl rand -hex 32

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# --- IRF Encryption ---
# Required in production; API fails closed without it.
IRF_ENCRYPTION_KEY=generate-with: openssl rand -hex 32

# --- Twilio (SMS notifications) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- Email (SMTP) ---
# Public-facing base URL used in email links (verify-email / reset-password).
APP_URL=https://your-domain.gov.ph
# Uncomment and fill to enable transactional email. Until EMAIL_HOST is set,
# the API runs in log-only mode (emails go to API logs, not mailboxes).
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_USER=kapwa@your-domain.gov.ph
# EMAIL_PASS=your-smtp-password
# EMAIL_FROM=KAPWA MSWDO <noreply@your-domain.gov.ph>
# For local testing: point at MailHog (docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog)
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# EMAIL_USER=mailhog
# EMAIL_PASS=mailhog
# EMAIL_FROM=KAPWA <noreply@kapwa.local>
# APP_URL=http://localhost:5173

# --- Caddy (reverse proxy) ---
CADDY_DOMAIN=kapwa.your-domain.gov.ph
CADDY_EMAIL=admin@your-domain.gov.ph