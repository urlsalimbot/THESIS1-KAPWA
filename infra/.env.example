# ============================================================
# Kapwa — Consolidated Environment Template
# ============================================================
# SINGLE source of truth for the production stack. Copy to
# `infra/.env.production` and fill in every value marked REQUIRED.
#
#   cp infra/.env.example infra/.env.production
#   # edit infra/.env.production, then:
#   ./deploy.sh
#
# This file is consumed by:
#   - kapwa-server/docker-compose.yml  (db, api, minio via env_file)
#   - infra/Caddyfile                  (mounted at /etc/caddy/.env)
#   - deploy.sh                        (sourced for fail-fast validation)
#
# Client values (VITE_*) are BUILD-TIME, not runtime — they are passed as
# build args by kapwa-server/docker-compose.yml (see the bottom section).
#
# NEVER commit a filled-in .env.production. It is gitignored.
# Generate secrets with:  openssl rand -hex 32
# ============================================================

# --- Runtime ---------------------------------------------------
NODE_ENV=production
TZ=Asia/Manila
# API listen port inside the container. Optional; defaults to 3000.
PORT=3000

# --- Database (REQUIRED) --------------------------------------
# DB_HOST must stay `db` — it is the compose service name.
DB_HOST=db
DB_PORT=5432
DB_USER=kapwa
DB_PASSWORD=change-me
DB_NAME=kapwa

# --- Authentication (REQUIRED) --------------------------------
# Signs access/refresh tokens and all socket handshakes. Changing it
# invalidates every existing session.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- IRF Encryption (REQUIRED — API fails closed without it) ---
# Must be >= 64 hex chars (32 bytes). deploy.sh rejects shorter values.
IRF_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# --- MinIO / object storage (REQUIRED) ------------------------
# MINIO_ENDPOINT must stay `minio` — it is the compose service name.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# --- Public URL (REQUIRED for working email links) ------------
# Public origin used in verify-email / reset-password links.
APP_URL=https://kapwa.your-domain.gov.ph

# --- Transactional email — Resend SMTP relay (OPTIONAL) -------
# Until EMAIL_HOST is set the API boots in LOG-ONLY mode: emails are
# written to the API logs and never delivered (users cannot verify).
#
# IMPORTANT: infra/.env.production is `source`d by deploy.sh, so any value
# containing spaces, `<`, `>`, or `&` MUST be wrapped in double quotes or
# the shell errors with "syntax error near unexpected token".
#
# Password is your Resend API key (Dashboard → API Keys → re_...).
# Port 465 = implicit TLS (secure:true in email.service.ts); 587 also works.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Active now: resend.dev only delivers to your own Resend account email.
EMAIL_FROM="KAPWA MSWDO <onboarding@resend.dev>"
# After verifying your domain in Resend (DNS SPF/DKIM), swap to:
# EMAIL_FROM="KAPWA MSWDO <noreply@kapwa.your-domain.gov.ph>"
#
# Local testing alternative (MailHog):
#   EMAIL_HOST=127.0.0.1
#   EMAIL_PORT=1025
#   EMAIL_USER=mailhog
#   EMAIL_PASS=mailhog
#   EMAIL_FROM="KAPWA <noreply@kapwa.local>"

# --- Twilio / SMS notifications (OPTIONAL) --------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- WebSocket CORS (REQUIRED in production) ------------------
# Comma-separated allowed origins for the /notifications and /chat
# sockets. Without it the API falls back to localhost-only origins and
# the deployed client's sockets are rejected.
NOTIF_WS_ORIGIN=https://kapwa.your-domain.gov.ph

# --- IRF PDF export (OPTIONAL) --------------------------------
# Owner password applied to generated IRF PDFs. Defaults to
# `kapwa-admin-2026` when unset.
PDF_OWNER_PW=change-me

# --- Caddy / TLS (OPTIONAL — wire up in infra/Caddyfile) ------
# Informational for the reverse proxy. The current Caddyfile serves
# plain HTTP on :80; enable the production stanza in infra/Caddyfile
# to terminate TLS for this domain.
CADDY_DOMAIN=kapwa.your-domain.gov.ph
CADDY_EMAIL=admin@your-domain.gov.ph

# --- Legacy (NOT currently read by any code) ------------------
# Present for backwards compatibility only. Safe to leave blank.
SYNC_SECRET=

# ============================================================
# Client build args — DO NOT put these in .env.production
# ============================================================
# Baked into the static bundle at image build time by
# kapwa-server/docker-compose.yml. They are listed here for
# reference only; changing them requires a rebuild.
#
#   VITE_API_URL=/api/v1   # same-origin path proxied by Caddy/nginx
#   VITE_WS_URL=           # empty = same-origin websockets
