{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Manila",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Security patches land immediately; they are the reason this bot exists.",
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": false,
      "schedule": ["at any time"]
    },
    {
      "description": "Group the noisy ecosystems so a week is one PR, not thirty.",
      "matchPackagePatterns": ["^@nestjs/", "^@types/", "^react", "^eslint", "^jest", "^vitest", "^@tiptap/", "^@radix-ui/"],
      "groupName": "framework & tooling"
    },
    {
      "description": "Major bumps stay manual: they need a human reading the changelog.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "addLabels": ["major-update"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on the first day of the month"] }
}
